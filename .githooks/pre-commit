#!/usr/bin/env bash
# Opt-in: git config core.hooksPath .githooks
# Runs ruff on newly added Python files (modified legacy files stay advisory,
# matching the CI lint job).
set -euo pipefail
files=$(git diff --cached --name-only --diff-filter=A -- '*.py')
if [ -z "$files" ]; then
  exit 0
fi
uv run --frozen --only-group dev ruff check $files
uv run --frozen --only-group dev ruff format --check $files
