#!/usr/bin/env bash
# Local guard for the CI gates that most often fail on submission PRs:
#   - codes format (json.dumps(doc, indent=1))
#   - validator integrity (trusted stack pin)
#   - prose (cited paths must resolve)
#   - ruff on newly added Python files (modified legacy files stay advisory)
set -e

# Codes format
changed_codes=$(git diff --cached --name-only --diff-filter=AMR -- 'codes/*.json' || true)
if [ -n "$changed_codes" ]; then
    python3 verify/check_codes_format.py --files $changed_codes
fi

# Validator integrity (trusted stack pin). Fast (<1s): fails if a critical file
# changed without re-pinning verify/validator_manifest.json.
python3 verify/check_validator_integrity.py

# Prose (file-level paths; PR-body citations are checked by prepush_prose_check.sh)
changed_md=$(git diff --cached --name-only --diff-filter=AMR -- 'notes/*.md' 'fieldnotes/*.md' || true)
if [ -n "$changed_md" ]; then
    python3 verify/check_prose.py --files $changed_md
fi

# Ruff on newly added Python files only.
files=$(git diff --cached --name-only --diff-filter=A -- '*.py' || true)
if [ -n "$files" ]; then
    uv run --frozen --only-group dev ruff check $files
    uv run --frozen --only-group dev ruff format --check $files
fi
